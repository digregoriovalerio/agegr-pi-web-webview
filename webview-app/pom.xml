<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>webview-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>webview-app</name>
    <description>JavaFX WebView app that opens a URL provided via input</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- 21.0.1 is the newest 21.x with linux-aarch64 natives on Maven Central -->
        <javafx.version>21.0.1</javafx.version>
        <!-- Overridden by the OS/arch profiles below -->
        <javafx.platform>windows</javafx.platform>
        <main.class>com.example.webview.WebViewApp</main.class>
    </properties>

    <!--
      Auto-select the JavaFX native classifier for the current OS/architecture.
      This machine (Raspberry Pi 5, linux/aarch64) resolves to "linux-aarch64".
    -->
    <profiles>
        <profile>
            <id>linux-aarch64</id>
            <activation>
                <os><family>unix</family><arch>aarch64</arch></os>
            </activation>
            <properties><javafx.platform>linux-aarch64</javafx.platform></properties>
        </profile>
        <profile>
            <id>linux-x64</id>
            <activation>
                <os><family>unix</family><arch>amd64</arch></os>
            </activation>
            <properties><javafx.platform>linux</javafx.platform></properties>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
        </profile>
        <profile>
            <id>mac-x64</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <properties><javafx.platform>mac</javafx.platform></properties>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Runs the app on the JavaFX module path: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
